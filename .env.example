# Discord Application Bot token (never commit this file)
DISCORD_BOT_TOKEN=

# Honeypot behavior
TRAP_CHANNEL_NAME=type-here-to-get-kicked
ENFORCE_ANY_TRAP_MESSAGE=true
# Set true to enforce scam signatures in every text channel, not just the trap channel.
SCAN_ALL_CHANNELS=false
ENFORCEMENT_ACTION=kick
MAX_IMAGE_BYTES=8388608
# Permanent audit-log channel; matches ⭐botlogs or botlogs case-insensitively.
LOG_CHANNEL_NAME=⭐botlogs
LOG_LEVEL=INFO

# Optional: only needed if Tesseract is installed outside the standard Windows path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
